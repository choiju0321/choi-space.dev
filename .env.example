# Choi Space local env

# Password for /write and /health (private archives)
LIFE_WRITE_SECRET=change-me

# Public site origin (sitemap · RSS · canonical · OG). Default: https://choi-space.dev
# NEXT_PUBLIC_SITE_URL=https://choi-space.dev

# Local Postgres (docker compose)
DATABASE_URL=postgresql://choi:choi@localhost:5432/choi_space

# --- 청약공고 크롤러 (npm run crawl:subscriptions) ---
# data.go.kr "한국부동산원_청약홈 분양정보 조회 서비스" 활용신청 후 서비스 키(Encoding)
APPLYHOME_SERVICE_KEY=
# 텔레그램 봇 (BotFather 로 봇 생성 → 토큰) · 알림 받을 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# (선택) 지역 필터 콤마 구분 · 이 날짜 이후 공고만
# CRAWL_REGIONS=서울,경기
# CRAWL_SINCE_NOTICE_DATE=2026-01-01
